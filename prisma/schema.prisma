// MATISP — schéma de données
// Décisions du 10/09/2026 : pas de protocole en V1 (table conservée, non alimentée),
// emplacement informatif seulement, pas de registre stupéfiants, conservation 1 an.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Fonction {
  ISP
  MSP
  CONDUCTEUR
  PHARMACIEN
  ADMIN
}

enum TypeDotation {
  SAC_ISP
  SAC_MED
  VLM
}

enum PorteeDotation {
  INDIVIDUEL
  COLLECTIF
}

enum CategorieProduit {
  MEDICAMENT
  SOLUTE
  DM_INJECTION
  VOIES_AERIENNES
  PANSEMENT
  HYGIENE
  DIVERS
  EQUIPEMENT
}

enum StatutIntervention {
  BROUILLON
  TERMINEE
  ENVOYEE
  CLOTUREE
}

enum TypeConsommation {
  CONSOMME
  PERDU
  CASSE
}

enum RoleIntervention {
  CREATEUR
  CONTRIBUTEUR
}

enum StatutEnvoi {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

model Cis {
  id         String       @id @default(uuid())
  code       String       @unique
  nom        String
  actif      Boolean      @default(true)
  utilisateurs Utilisateur[]
  dotations  Dotation[]
}

model Utilisateur {
  id        String   @id @default(uuid())
  matricule String   @unique
  nom       String
  prenom    String
  fonction  Fonction
  cisId     String?
  cis       Cis?     @relation(fields: [cisId], references: [id])

  /// Droit technique d'administration, indépendant de la fonction professionnelle
  /// (un ADMIN reste médecin, infirmier, etc. — voir correctif du 14/09/2026).
  admin     Boolean  @default(false)
  /// Accès à la dotation VLM (SMUR sapeurs-pompiers), réservé à quelques ISP/médecins.
  accesVLM  Boolean  @default(false)
  /// Adresse mail personnelle, facultative, pour s'envoyer une copie des réassorts.
  email     String?

  /// Argon2id du matricule au premier import, modifiable par l'utilisateur.
  mdpHash   String
  /// PIN facultatif de déverrouillage local (4 à 6 chiffres), jamais obligatoire.
  pinHash   String?

  actif     Boolean  @default(true)
  creeLe    DateTime @default(now())
  majLe     DateTime @updatedAt

  dotationsDetenues  Dotation[]              @relation("Detenteur")
  participations     InterventionUtilisateur[]
  consommations      Consommation[]
  sessions           Session[]
  journal            Journal[]

  @@index([nom, prenom])
}

model Session {
  id             String      @id @default(uuid())
  utilisateurId  String
  utilisateur    Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  refreshHash    String      @unique
  expireLe       DateTime
  creeLe         DateTime    @default(now())
  derniereUtilLe DateTime?
  revoqueLe      DateTime?

  @@index([utilisateurId])
}

model Produit {
  id             String           @id @default(uuid())
  code           String           @unique // P001…, repris du catalogue
  designation    String
  /// Famille de variantes : « Sonde d'intubation », « Seringue », « Cathéter veineux ».
  gamme          String?
  dci            String?
  nomCommercial  String?
  unite          String           @default("unité")
  categorie      CategorieProduit
  /// Couleurs, calibres, abréviations, noms commerciaux. Alimente la recherche.
  synonymes      String[]         @default([])
  /// Faux = équipement : hors recherche de saisie, visible seulement en perte/casse.
  estConsommable Boolean          @default(true)
  estMedicament  Boolean          @default(false)
  actif          Boolean          @default(true)
  remarque       String?
  creeLe         DateTime         @default(now())
  majLe          DateTime         @updatedAt

  lignes         ModeleLigne[]
  consommations  Consommation[]
  suggestions    ProtocoleProduit[]

  @@index([categorie])
  @@index([gamme])
}

model ModeleDotation {
  id       String       @id @default(uuid())
  code     String       @unique // SAC_ISP, SAC_MED, VLM
  type     TypeDotation
  libelle  String
  version  Int          @default(1)
  actif    Boolean      @default(true)
  majLe    DateTime     @updatedAt

  lignes    ModeleLigne[]
  dotations Dotation[]
}

model ModeleLigne {
  id                String         @id @default(uuid())
  modeleId          String
  modele            ModeleDotation @relation(fields: [modeleId], references: [id], onDelete: Cascade)
  produitId         String
  produit           Produit        @relation(fields: [produitId], references: [id], onDelete: Cascade)
  quantiteTheorique Int            @default(0)
  /// Informatif en V1 (décision Ben), utilisé par le contrôle de dotation en V2.
  emplacement       String?
  remarque          String?

  @@unique([modeleId, produitId, emplacement])
  @@index([modeleId])
}

model Dotation {
  id          String         @id @default(uuid())
  modeleId    String
  modele      ModeleDotation @relation(fields: [modeleId], references: [id])
  /// Identifiant physique : « ISP-17 », « VLM ».
  identifiant String         @unique
  portee      PorteeDotation
  cisId       String?
  cis         Cis?           @relation(fields: [cisId], references: [id])
  detenteurId String?
  detenteur   Utilisateur?   @relation("Detenteur", fields: [detenteurId], references: [id])
  actif       Boolean        @default(true)

  interventions InterventionDotation[]
  consommations Consommation[]

  @@index([cisId])
  @@index([detenteurId])
}

/// V2 — table créée pour éviter une reprise de données, non alimentée en V1.
model Protocole {
  id       String             @id @default(uuid())
  code     String             @unique
  nom      String
  actif    Boolean            @default(true)
  produits ProtocoleProduit[]
  interventions Intervention[]
}

model ProtocoleProduit {
  id               String    @id @default(uuid())
  protocoleId      String
  protocole        Protocole @relation(fields: [protocoleId], references: [id], onDelete: Cascade)
  produitId        String
  produit          Produit   @relation(fields: [produitId], references: [id], onDelete: Cascade)
  quantiteSuggeree Int       @default(1)

  @@unique([protocoleId, produitId])
}

model Intervention {
  id            String             @id // ULID généré côté client
  crss          String?
  debutLe       DateTime
  finLe         DateTime?
  statut        StatutIntervention @default(BROUILLON)
  verrouilleeLe DateTime?
  clotureeLe    DateTime?
  protocoleId   String?
  protocole     Protocole?         @relation(fields: [protocoleId], references: [id])
  creeLe        DateTime           @default(now())
  majLe         DateTime           @updatedAt

  utilisateurs InterventionUtilisateur[]
  dotations    InterventionDotation[]
  consommations Consommation[]
  envois        Envoi[]

  @@index([crss])
  @@index([statut])
  @@index([debutLe])
}

model InterventionUtilisateur {
  interventionId String
  intervention   Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  role           RoleIntervention @default(CONTRIBUTEUR)
  rejointLe      DateTime         @default(now())

  @@id([interventionId, utilisateurId])
  @@index([utilisateurId])
}

model InterventionDotation {
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  dotationId     String
  dotation       Dotation     @relation(fields: [dotationId], references: [id], onDelete: Cascade)

  @@id([interventionId, dotationId])
}

/// Événement, jamais écrasé : l'annulation passe par quantite = 0.
model Consommation {
  id             String           @id // ULID généré côté client
  interventionId String
  intervention   Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  utilisateurId  String
  utilisateur    Utilisateur      @relation(fields: [utilisateurId], references: [id])
  dotationId     String
  dotation       Dotation         @relation(fields: [dotationId], references: [id])
  /// Facultatif : vide quand le produit n'est pas encore au catalogue, auquel
  /// cas `nomLibre` porte le nom saisi à la main sur le terrain (décision du
  /// 16/09/2026 — l'appli ne doit jamais bloquer une saisie faute de fiche
  /// catalogue). Le catalogue reste la seule source de vérité éditoriale :
  /// personne n'y ajoute rien tant que Ben ne l'a pas intégré via le classeur.
  produitId      String?
  produit        Produit?         @relation(fields: [produitId], references: [id])
  nomLibre       String?
  quantite       Int
  type           TypeConsommation @default(CONSOMME)
  commentaire    String?
  saisiLe        DateTime
  synchroLe      DateTime         @default(now())

  @@index([interventionId])
  @@index([utilisateurId])
  @@index([produitId])
}

model Destinataire {
  id             String   @id @default(uuid())
  libelle        String
  email          String
  cocheParDefaut Boolean  @default(false)
  actif          Boolean  @default(true)
  ordre          Int      @default(0)
}

model Envoi {
  id             String       @id @default(uuid())
  interventionId String
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  destinataires  String[]
  pdfChemin      String?
  statut         StatutEnvoi  @default(EN_ATTENTE)
  erreur         String?
  creeLe         DateTime     @default(now())
  envoyeLe       DateTime?

  @@index([interventionId])
}

model Journal {
  id            String       @id @default(uuid())
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])
  action        String
  cible         String?
  detail        String?
  horodatage    DateTime     @default(now())

  @@index([horodatage])
}

/// Compteur de version du catalogue : le client ne retélécharge que s'il a changé.
model MetaCatalogue {
  id      Int      @id @default(1)
  version Int      @default(1)
  majLe   DateTime @updatedAt
}
